# Application Configuration
APP_NAME="AI Student Study & Research Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dental_agent_db"
DATABASE_SYNC_URL="postgresql+psycopg://postgres:postgres@localhost:5432/dental_agent_db"

# Security & Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER="groq"
ENABLE_GEMINI=true

# Groq Configuration (Fast conversational inference, query classification, basic tutoring, MCQs)
GROQ_API_KEY="gsk_placeholder_replace_with_real_groq_key"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30.0

# Google Gemini Configuration (Complex synthesis, multi-paper research, long-context, multimodal)
GEMINI_API_KEY="placeholder_replace_with_real_gemini_key"
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_FLASH_MODEL="gemini-1.5-flash"
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=60.0

# Embedding Configuration
# Options: "fastembed" (local zero-cost BAAI/bge-small-en-v1.5) or "gemini"
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# Document Processing & RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25
UPLOAD_STORAGE_DIR="./uploads"

# Scholarly & Web Research APIs
# NCBI PubMed (no key required for low rate limits, optional key for 10 req/sec)
NCBI_API_KEY=""
EUROPE_PMC_BASE_URL="https://www.ebi.ac.uk/europepmc/webservices/rest"
CROSSREF_BASE_URL="https://api.crossref.org"
TAVILY_API_KEY=""
RESEARCH_MAX_RESULTS=5

# Page Triage & Routed Extraction
# DPI used when rasterizing PDF pages for Gemini Vision
PYMUPDF_DPI=200
# Minimum words below which a visually dense page is considered scanned
TRIAGE_SCANNED_WORD_FLOOR=50
# Ratio vs document mean_words_per_page for scanned heuristic
TRIAGE_SCANNED_WORD_RATIO=0.15
# Image coverage percentage threshold for scanned page classification
TRIAGE_SCANNED_IMAGE_COVERAGE_PCT=60
# Max concurrent pages extracted per document
EXTRACTION_CONCURRENCY=3
# Max worker threads for sync PDF/Docling extraction
EXTRACTION_THREAD_POOL_SIZE=4
# Vision model and retry limit for diagrams and scanned pages
GEMINI_VISION_MODEL="gemini-1.5-pro"
GEMINI_VISION_MAX_RETRIES=2
# Preferred table extractor: docling | marker | unstructured
TABLE_EXTRACTOR="docling"

# Bi-Encoder Embedding & Hybrid Retrieval (BAAI/bge-m3 + RRF + Cross-Encoder)
EMBED_MODEL="BAAI/bge-m3"
EMBED_DIMENSION=1024
EMBED_BATCH_SIZE=16
EMBED_USE_ONNX=true
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
RETRIEVAL_DENSE_TOPK=50
RETRIEVAL_SPARSE_TOPK=50
RRF_K=60
RRF_FUSED_TOPK=20
FINAL_TOPK=5

# Async Ingestion Queue (Celery + Redis) & Object Storage (S3/MinIO)
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"
S3_ENDPOINT_URL=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
USE_ASYNC_INGESTION=true

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="student_assistant"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
